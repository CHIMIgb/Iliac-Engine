# =============================================================================
# .env.example — plantilla de variables de entorno del backend
# Copiar a .env y rellenar. El .env real NUNCA se versiona (gitignored).
# =============================================================================

# Conexión a PostgreSQL (DATABASE.md §8 A2: DB iliac_engine, PostgreSQL 18.4 en Windows)
DATABASE_URL="postgresql://postgres:<password>@127.0.0.1:5432/iliac_engine?schema=public"

# --- Se usan a partir de la Fase B1 (esqueleto del servidor) ---
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
PORT=3000
PUBLIC_URL="http://localhost:3000"

# --- Se usa a partir de la Fase C3 (assets) ---
# Directorio de blobs de assets. Opcional: por defecto <server>/storage/uploads
# (resuelto con import.meta.dirname, independiente del CWD).
STORAGE_PATH=""
